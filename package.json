{
  "name": "password-website",
  "version": "1.0.0",
  "description": "German sentence passphrase generator website",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/script.ts --bundle --minify --target=es2020 --outfile=docs/script.js",
    "watch": "esbuild src/script.ts --bundle --sourcemap --target=es2020 --outfile=docs/script.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist/tests --out-extension:.js=.mjs && node --test dist/tests/",
    "sync-wordlists": "node scripts/sync-wordlists.mjs",
    "start": "lite-server",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^20.11.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "lite-server": "^2.6.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ger-morph-pw-gen": "file:../ger-morph-pw-gen"
  }
}
